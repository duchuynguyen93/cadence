<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ngôn ngữ thiết kế: dải trung tính gần đen ("ink") + đúng MỘT màu nhấn hổ phách.

        Token lấy từ chính computed style của lumenplayer.net, giống hệt bộ mà
        Nocturne (trình phát video cùng nhà) đang dùng — hai app trông cùng một
        họ là chủ ý, không phải trùng hợp.

        Nguyên tắc phải giữ, vì đây là thứ dễ mất nhất khi thêm tính năng:
        CHỈ MỘT MÀU NHẤN, VÀ DÙNG DÈ. Trên bề mặt này chỉ có nút phát và phần
        đã phát của thanh tua là màu hổ phách. Nhờ vậy mắt tìm được nút phát
        ngay lập tức. Thêm một điểm nhấn nữa là hỏng cả hệ thống.

        Số đo:
        - Chữ giao diện 13px (giữ nguyên độ nén cũ — danh sách nhạc cần mật độ)
        - Bo góc 8px cho hàng/nút, 14px cho panel — cong nhẹ, không vuông góc
        - Timecode dùng font mono, xem MonoFontFamily bên dưới
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <!-- Dải ink, tối dần lên theo độ "nổi" của bề mặt -->
                    <SolidColorBrush x:Key="WindowBackground" Color="#0A0A0B" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="ContentBackground" Color="#111114" />
                    <SolidColorBrush x:Key="ElevatedBackground" Color="#16161B" />

                    <SolidColorBrush x:Key="TextPrimary" Color="#F8F8FA" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#A0A0AD" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#6B6B7A" />

                    <SolidColorBrush x:Key="Separator" Color="#26262E" />
                    <SolidColorBrush x:Key="HoverOverlay" Color="#FFFFFF" Opacity="0.06" />
                    <SolidColorBrush x:Key="SelectedOverlay" Color="#FFFFFF" Opacity="0.10" />

                    <!-- Sọc hàng chẵn: rất nhạt, chỉ đủ để mắt bám hàng ở danh sách dài -->
                    <SolidColorBrush x:Key="RowStripe" Color="#FFFFFF" Opacity="0.025" />

                    <SolidColorBrush x:Key="Accent" Color="#F5A623" />
                    <SolidColorBrush x:Key="AccentHover" Color="#FFB627" />
                    <SolidColorBrush x:Key="AccentMuted" Color="#F5A623" Opacity="0.20" />
                    <!-- Chữ/ký hiệu nằm TRÊN nền hổ phách: phải là màu nền, không phải trắng -->
                    <SolidColorBrush x:Key="OnAccent" Color="#0A0A0B" />

                    <SolidColorBrush x:Key="TrafficRed" Color="#FF5F57" />
                    <SolidColorBrush x:Key="TrafficYellow" Color="#FEBC2E" />
                    <SolidColorBrush x:Key="TrafficGreen" Color="#28C840" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!--
                        Bản sáng là phiên bản đảo của cùng hệ thống, không phải một
                        bảng màu khác. Màu nhấn tối đi một nấc vì #F5A623 trên nền
                        trắng không đủ tương phản để làm chữ.
                    -->
                    <SolidColorBrush x:Key="WindowBackground" Color="#F8F8FA" />
                    <SolidColorBrush x:Key="SidebarBackground" Color="#00FFFFFF" />
                    <SolidColorBrush x:Key="ContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ElevatedBackground" Color="#F1F1F4" />

                    <SolidColorBrush x:Key="TextPrimary" Color="#111114" />
                    <SolidColorBrush x:Key="TextSecondary" Color="#3D3D48" />
                    <SolidColorBrush x:Key="TextTertiary" Color="#6B6B7A" />

                    <SolidColorBrush x:Key="Separator" Color="#E8E8ED" />
                    <SolidColorBrush x:Key="HoverOverlay" Color="#0A0A0B" Opacity="0.05" />
                    <SolidColorBrush x:Key="SelectedOverlay" Color="#0A0A0B" Opacity="0.08" />
                    <SolidColorBrush x:Key="RowStripe" Color="#0A0A0B" Opacity="0.022" />

                    <SolidColorBrush x:Key="Accent" Color="#C87E12" />
                    <SolidColorBrush x:Key="AccentHover" Color="#E09612" />
                    <SolidColorBrush x:Key="AccentMuted" Color="#C87E12" Opacity="0.18" />
                    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />

                    <SolidColorBrush x:Key="TrafficRed" Color="#FF5F57" />
                    <SolidColorBrush x:Key="TrafficYellow" Color="#FEBC2E" />
                    <SolidColorBrush x:Key="TrafficGreen" Color="#28C840" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <x:Double x:Key="FontSizeLarge">22</x:Double>
            <x:Double x:Key="FontSizeTitle">15</x:Double>
            <x:Double x:Key="FontSizeBody">13</x:Double>
            <x:Double x:Key="FontSizeSmall">11</x:Double>

            <!--
                Timecode phải là font đều chữ số. Với font tỉ lệ, bề rộng chữ số
                đổi khi đếm nên cả cụm bên phải giật ngang mỗi giây — thứ khó chịu
                nhất mà một thanh phát có thể làm. Không bundle font mono nào nên
                khai báo chuỗi dự phòng, và mọi nền tảng đều có ít nhất một cái.
            -->
            <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, monospace</FontFamily>

            <CornerRadius x:Key="RadiusRow">8</CornerRadius>
            <CornerRadius x:Key="RadiusPanel">14</CornerRadius>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ── Đèn giao thông ────────────────────────────────────────────────────
         Giữ lại: chúng có trong chính mockup của Lumen, và đọc là chrome của hệ
         điều hành chứ không phải điểm nhấn nội dung — nên không phá nguyên tắc
         một-màu-nhấn ở trên. -->
    <Style Selector="Button.traffic">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="6" Width="12" Height="12" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.traffic.close">
        <Setter Property="Background" Value="{DynamicResource TrafficRed}" />
    </Style>
    <Style Selector="Button.traffic.minimise">
        <Setter Property="Background" Value="{DynamicResource TrafficYellow}" />
    </Style>
    <Style Selector="Button.traffic.zoom">
        <Setter Property="Background" Value="{DynamicResource TrafficGreen}" />
    </Style>
    <Style Selector="Border.trafficCluster:not(.active) Button.traffic">
        <Setter Property="Background" Value="{DynamicResource TextTertiary}" />
    </Style>

    <!-- ── Mục sidebar ───────────────────────────────────────────────────── -->
    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
    </Style>
    <!-- Mục đang chọn: chữ sáng lên là đủ, không cần thanh màu -->
    <Style Selector="ListBox.sidebar ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedOverlay}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
    </Style>

    <!-- ── Bảng danh sách bài ────────────────────────────────────────────── -->
    <Style Selector="ListBox.tracks">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:nth-child(2n) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowStripe}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
    </Style>
    <Style Selector="ListBox.tracks ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
    </Style>
    <!--
        Hàng đang chọn dùng nền hổ phách MỜ chứ không tô đặc. Tô đặc sẽ thành một
        thanh hổ phách dài chạy ngang màn hình, cạnh tranh trực tiếp với nút phát
        — đúng thứ mà nguyên tắc một-màu-nhấn sinh ra để ngăn.
    -->
    <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
    </Style>

    <!-- ── Nút điều khiển phát ───────────────────────────────────────────── -->
    <Style Selector="Button.transport">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.transport:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
    </Style>
    <Style Selector="Button.transport.toggled">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!--
        Nút phát: hình tròn hổ phách đặc với ký hiệu khoét màu nền. Đây là dấu hiệu
        nhận diện của cả ngôn ngữ thiết kế — và là lý do mọi thứ còn lại quanh nó
        có thể im lặng đến vậy.
    -->
    <Style Selector="Button.transport.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.transport.primary /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="Button.transport.primary:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.transport.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="Button.transport.primary:pressed /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- ── Thanh tua ────────────────────────────────────────────────────────
         Rãnh 4px, phần đã phát màu hổ phách, núm chỉ hiện khi rê chuột. Ở trạng
         thái nghỉ đây là một vạch chỉ tiến độ; có con trỏ trên nó mới thành một
         control. -->
    <Style Selector="Slider.scrub">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Slider.scrub /template/ Track">
        <Setter Property="Height" Value="4" />
    </Style>
    <Style Selector="Slider.scrub /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Slider.scrub /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource SelectedOverlay}" />
    </Style>
    <Style Selector="Slider.scrub /template/ Thumb">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Slider.scrub:pointerover /template/ Thumb">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Slider.scrub:pressed /template/ Thumb">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Slider.scrub:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- ── Timecode ─────────────────────────────────────────────────────────
         Font mono để chữ số không đổi bề rộng khi đếm. -->
    <Style Selector="TextBlock.timecode">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ── Ô tìm kiếm ────────────────────────────────────────────────────── -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox.search:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ── Nút phụ ở sidebar ─────────────────────────────────────────────── -->
    <Style Selector="Button.sidebarAction">
        <Setter Property="Background" Value="{DynamicResource ElevatedBackground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusRow}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.sidebarAction:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SelectedOverlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
    </Style>
    <Style Selector="Button.sidebarAction:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <!-- Giãn chữ: nhãn nhóm viết hoa mà không giãn thì đọc thành một khối đặc -->
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="Margin" Value="18,12,0,4" />
    </Style>

</Styles>
