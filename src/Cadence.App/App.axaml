<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cadence.App.App"
             xmlns:local="using:Cadence.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <!--
            FluentTheme nằm dưới để mượn control template (ListBox, Slider, TextBox...),
            còn Theme.axaml đè lên trên để thay toàn bộ màu sắc và số đo theo macOS.
            Thứ tự này quan trọng: đảo lại thì Fluent sẽ ghi đè và mọi thứ trông như Windows.
        -->
        <FluentTheme />
        <!-- Đường dẫn tương đối, không phải avares://<tên-assembly>/... : dạng
             tuyệt đối gắn chết tên assembly vào XAML, và đổi AssemblyName sẽ
             làm hỏng nó lúc build với một thông báo chẳng liên quan gì. -->
        <StyleInclude Source="/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
